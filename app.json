{
  "expo": {
    "name": "DotoHub Mobile",
    "slug": "dotohub-mobile",
    "scheme": "dotohub",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3755"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "bj.dotoplus.hub",
      "infoPlist": {
        "NSCameraUsageDescription": "Scanner les QR DotoCard des patients.",
        "NSFaceIDUsageDescription": "Déverrouillage biométrique de DotoHub"
      }
    },
    "android": {
      "package": "bj.dotoplus.hub",
      "adaptiveIcon": {
        "backgroundColor": "#1E3755",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "usesCleartextTraffic": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E3755",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Autoriser DotoHub à utiliser Face ID pour le déverrouillage."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser DotoHub à utiliser la caméra pour scanner les DotoCard."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser DotoHub à accéder aux photos.",
          "cameraPermission": "Autoriser DotoHub à prendre une photo."
        }
      ],
      "expo-font",
      "expo-asset",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "9f3dd0ef-9bf1-49b9-8579-3f2faaa9233e"
      }
    },
    "owner": "davidanato"
  }
}
